<mxfile host="drawio"><diagram name="On the phone" id="On the phone"><mxGraphModel dx="1900" dy="1070" grid="1" gridSize="10" guides="1" page="1" pageWidth="1900" pageHeight="1070" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Android phone - privacy boundary: no INTERNET permission, video never leaves the device" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#0F766E;strokeWidth=2;dashed=1;verticalAlign=top;align=right;spacingRight=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#0F766E;fontFamily=Helvetica;arcSize=2;" vertex="1" parent="1"><mxGeometry x="10" y="10" width="1880" height="1050" as="geometry"/></mxCell><mxCell id="c4" value="1  Capture  (MainActivity.kt)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#9A9A9A;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#333333;fontFamily=Helvetica;arcSize=3;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="560" height="300" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;CameraX&lt;/b&gt;&lt;br&gt;back camera (exocentric) / front&lt;br&gt;1280x720 RGBA, keep-latest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A4A4A;fontColor=#1A1A1A;fontSize=12;fontFamily=Helvetica;arcSize=8;" vertex="1" parent="1"><mxGeometry x="50" y="95" width="250" height="85" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Low-light check&lt;/b&gt;&lt;br&gt;mean luma every 15th frame&lt;br&gt;&lt; 0.18 → torch or white screen ring" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A4A4A;fontColor=#1A1A1A;fontSize=12;fontFamily=Helvetica;arcSize=8;" vertex="1" parent="1"><mxGeometry x="320" y="95" width="250" height="85" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Idle gate&lt;/b&gt;&lt;br&gt;no hand for 2 s → analyse every&lt;br&gt;2nd frame (saves power)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A4A4A;fontColor=#1A1A1A;fontSize=12;fontFamily=Helvetica;arcSize=8;" vertex="1" parent="1"><mxGeometry x="50" y="205" width="250" height="85" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Camera fallback + memory&lt;/b&gt;&lt;br&gt;missing camera → use the other;&lt;br&gt;choice remembered" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A4A4A;fontColor=#1A1A1A;fontSize=12;fontFamily=Helvetica;arcSize=8;" vertex="1" parent="1"><mxGeometry x="320" y="205" width="250" height="85" as="geometry"/></mxCell><mxCell id="c9" value="frame: Bitmap 720x1280" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#555555;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="50" y="300" width="520" height="30" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A4A4A;fontSize=11;fontColor=#333333;fontFamily=Helvetica;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A4A4A;fontSize=11;fontColor=#333333;fontFamily=Helvetica;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="2  Perception  (Landmarks.kt, Enhance.kt)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#9A9A9A;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#333333;fontFamily=Helvetica;arcSize=3;" vertex="1" parent="1"><mxGeometry x="620" y="50" width="600" height="300" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Adaptive sharpening&lt;/b&gt;&lt;br&gt;sharpness check every 5th frame;&lt;br&gt;unsharp mask only if blurry &amp; not dark" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A4A4A;fontColor=#1A1A1A;fontSize=12;fontFamily=Helvetica;arcSize=8;" vertex="1" parent="1"><mxGeometry x="640" y="95" width="270" height="85" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;MediaPipe Holistic&lt;/b&gt;&lt;br&gt;GPU delegate, CPU fallback&lt;br&gt;pose 33 + hands 2x21 + face 13" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A4A4A;fontColor=#1A1A1A;fontSize=12;fontFamily=Helvetica;arcSize=8;" vertex="1" parent="1"><mxGeometry x="930" y="95" width="270" height="85" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Landmark frame&lt;/b&gt;&lt;br&gt;88 points x (x, y, z)&lt;br&gt;x, z scaled by aspect" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A4A4A;fontColor=#1A1A1A;fontSize=12;fontFamily=Helvetica;arcSize=8;" vertex="1" parent="1"><mxGeometry x="930" y="205" width="270" height="85" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Hints&lt;/b&gt;&lt;br&gt;face &gt; 40% of frame → &quot;move back&quot;&lt;br&gt;too dark → &quot;add light&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A4A4A;fontColor=#1A1A1A;fontSize=12;fontFamily=Helvetica;arcSize=8;" vertex="1" parent="1"><mxGeometry x="640" y="205" width="270" height="85" as="geometry"/></mxCell><mxCell id="c17" value="88 x 3 floats per frame  |  14.0 ms p95 (laptop CPU)" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#555555;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="640" y="300" width="560" height="30" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A4A4A;fontSize=11;fontColor=#333333;fontFamily=Helvetica;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A4A4A;fontSize=11;fontColor=#333333;fontFamily=Helvetica;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A4A4A;fontSize=11;fontColor=#333333;fontFamily=Helvetica;dashed=1;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="3  Sign detection  (Segmenter.kt)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#9A9A9A;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#333333;fontFamily=Helvetica;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1250" y="50" width="630" height="300" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Start&lt;/b&gt;&lt;br&gt;hand seen in 2 frames&lt;br&gt;(+5 frames pre-roll)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A4A4A;fontColor=#1A1A1A;fontSize=12;fontFamily=Helvetica;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1270" y="95" width="180" height="85" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;End (in ms, any fps)&lt;/b&gt;&lt;br&gt;0.5 s still, 0.5 s no hands,&lt;br&gt;or 3.5 s max" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A4A4A;fontColor=#1A1A1A;fontSize=12;fontFamily=Helvetica;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1470" y="95" width="190" height="85" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Is it a sign?&lt;/b&gt;&lt;br&gt;≥ 5 frames, ≥ 0.4 s, and wrist&lt;br&gt;≥ 0.2 or fingertip ≥ 0.25 face h." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A4A4A;fontColor=#1A1A1A;fontSize=12;fontFamily=Helvetica;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1680" y="95" width="185" height="85" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Why ranges, not paths&lt;/b&gt;&lt;br&gt;tracker jitter adds up along a path;&lt;br&gt;5-95% ranges ignore it → 0/600 idle&lt;br&gt;streams produce a word" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A4A4A;fontColor=#1A1A1A;fontSize=12;fontFamily=Helvetica;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1270" y="205" width="390" height="85" as="geometry"/></mxCell><mxCell id="c26" value="segment: T x 88 x 3" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#555555;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="1680" y="230" width="185" height="30" as="geometry"/></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A4A4A;fontSize=11;fontColor=#333333;fontFamily=Helvetica;" edge="1" parent="1" source="c22" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A4A4A;fontSize=11;fontColor=#333333;fontFamily=Helvetica;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="4  Understanding  (Features.kt, Recognizer.kt, ONNX Runtime)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#9A9A9A;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#333333;fontFamily=Helvetica;arcSize=3;" vertex="1" parent="1"><mxGeometry x="30" y="380" width="1850" height="300" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Canonical body frame&lt;/b&gt;&lt;br&gt;origin between shoulders, unit =&lt;br&gt;shoulder width; roll and yaw removed;&lt;br&gt;virtual shoulders if cut off" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A4A4A;fontColor=#1A1A1A;fontSize=12;fontFamily=Helvetica;arcSize=8;" vertex="1" parent="1"><mxGeometry x="50" y="425" width="300" height="100" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Hands&lt;/b&gt;&lt;br&gt;assigned to nearest pose wrist;&lt;br&gt;left-handers mirrored; gaps ≤ 6&lt;br&gt;frames interpolated and flagged" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A4A4A;fontColor=#1A1A1A;fontSize=12;fontFamily=Helvetica;arcSize=8;" vertex="1" parent="1"><mxGeometry x="370" y="425" width="280" height="100" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;239 features per frame&lt;/b&gt;&lt;br&gt;hand shape 170, orientation 12,&lt;br&gt;location 24, motion 16, face 11,&lt;br&gt;quality 6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A4A4A;fontColor=#1A1A1A;fontSize=12;fontFamily=Helvetica;arcSize=8;" vertex="1" parent="1"><mxGeometry x="670" y="425" width="280" height="100" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Motion-weighted sampling&lt;/b&gt;&lt;br&gt;trim rest pose, pick 32 frames,&lt;br&gt;more where hands move" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A4A4A;fontColor=#1A1A1A;fontSize=12;fontFamily=Helvetica;arcSize=8;" vertex="1" parent="1"><mxGeometry x="970" y="425" width="260" height="100" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;Sign gate (INT8)&lt;/b&gt;&lt;br&gt;EchoNet 88 k params, 0.23 MB&lt;br&gt;0.12 ms; sign vs not-a-sign&lt;br&gt;threshold keeps 90% of signs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4F1;strokeColor=#0F766E;fontColor=#0B3B36;fontSize=12;fontFamily=Helvetica;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1250" y="425" width="290" height="100" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;Word model (INT8)&lt;/b&gt;&lt;br&gt;4-network ensemble, 5.1 M params&lt;br&gt;6.2 MB; 2.4 ms per call&lt;br&gt;100 words (WLASL100)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4F1;strokeColor=#0F766E;fontColor=#0B3B36;fontSize=12;fontFamily=Helvetica;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1560" y="425" width="300" height="100" as="geometry"/></mxCell><mxCell id="c36" value="input tensor 1 x 32 x 239  (features: same code as Python, golden-tested to ~1e-6)" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#555555;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="50" y="540" width="1180" height="30" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;Inside each network&lt;/b&gt;&lt;br&gt;per-group projection → quality gate (trusts only what was seen) → 4 depthwise-conv blocks + 2 attention blocks → mean pool → 100 logits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4F1;strokeColor=#0F766E;fontColor=#0B3B36;fontSize=12;fontFamily=Helvetica;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="580" width="1180" height="80" as="geometry"/></mxCell><mxCell id="c38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A4A4A;fontSize=11;fontColor=#333333;fontFamily=Helvetica;" edge="1" parent="1" source="c30" target="c31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A4A4A;fontSize=11;fontColor=#333333;fontFamily=Helvetica;" edge="1" parent="1" source="c31" target="c32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A4A4A;fontSize=11;fontColor=#333333;fontFamily=Helvetica;" edge="1" parent="1" source="c32" target="c33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A4A4A;fontSize=11;fontColor=#333333;fontFamily=Helvetica;" edge="1" parent="1" source="c33" target="c34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A4A4A;fontSize=11;fontColor=#333333;fontFamily=Helvetica;" edge="1" parent="1" source="c34" target="c35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c43" value="runs once per sign, not per frame" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#0F766E;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1250" y="540" width="610" height="30" as="geometry"/></mxCell><mxCell id="c44" value="5  Output and conversation  (MainActivity.kt, Sentence.kt, Conversation.kt, HudView.kt)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#9A9A9A;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#333333;fontFamily=Helvetica;arcSize=3;" vertex="1" parent="1"><mxGeometry x="30" y="710" width="1850" height="330" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;Caption rule&lt;/b&gt;&lt;br&gt;not a sign → nothing&lt;br&gt;p ≥ 45% and 20 pts ahead → word&lt;br&gt;p ≥ 25% → grey 'word?' + 2 options" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A4A4A;fontColor=#1A1A1A;fontSize=12;fontFamily=Helvetica;arcSize=8;" vertex="1" parent="1"><mxGeometry x="50" y="755" width="300" height="110" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;Sentence builder&lt;/b&gt;&lt;br&gt;words join; repeat within 2.5 s&lt;br&gt;counted once; 4 s pause → full stop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A4A4A;fontColor=#1A1A1A;fontSize=12;fontFamily=Helvetica;arcSize=8;" vertex="1" parent="1"><mxGeometry x="370" y="755" width="280" height="110" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;HUD&lt;/b&gt;&lt;br&gt;caption + confidence bar,&lt;br&gt;listening / signing, which hands,&lt;br&gt;conversation, hints" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F766E;strokeColor=#0F766E;fontColor=#FFFFFF;fontSize=12;fontFamily=Helvetica;fontStyle=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="670" y="755" width="280" height="110" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;Voice&lt;/b&gt;&lt;br&gt;offline TTS voice only&lt;br&gt;(network voices skipped)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F766E;strokeColor=#0F766E;fontColor=#FFFFFF;fontSize=12;fontFamily=Helvetica;fontStyle=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="970" y="755" width="240" height="110" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;Reply (two-way)&lt;/b&gt;&lt;br&gt;microphone → on-device speech&lt;br&gt;recognition → blue caption&lt;br&gt;(fallback if no offline pack)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A4A4A;fontColor=#1A1A1A;fontSize=12;fontFamily=Helvetica;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1230" y="755" width="300" height="110" as="geometry"/></mxCell><mxCell id="c50" value="&lt;b&gt;Test &amp; measure&lt;/b&gt;&lt;br&gt;built-in clips, sentence test,&lt;br&gt;pick a video, 10-min run →&lt;br&gt;latency, power, heat CSV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A4A4A;fontColor=#1A1A1A;fontSize=12;fontFamily=Helvetica;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1550" y="755" width="310" height="110" as="geometry"/></mxCell><mxCell id="c51" value="outputs: text on screen, speech; nothing stored, nothing sent" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#555555;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="1230" y="905" width="630" height="30" as="geometry"/></mxCell><mxCell id="c52" value="Edge cases handled: no hands · too close · too dark · blur · hand at rest · fidget · out-of-vocabulary sign · left-handed signer · shoulders out of frame · signer far away · missing camera · no offline voice / speech pack · app in test mode (camera paused)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="960" width="1810" height="60" as="geometry"/></mxCell><mxCell id="c53" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A4A4A;fontSize=11;fontColor=#333333;fontFamily=Helvetica;" edge="1" parent="1" source="c45" target="c46"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A4A4A;fontSize=11;fontColor=#333333;fontFamily=Helvetica;" edge="1" parent="1" source="c46" target="c47"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c55" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A4A4A;fontSize=11;fontColor=#333333;fontFamily=Helvetica;" edge="1" parent="1" source="c46" target="c48"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="510" y="880"/><mxPoint x="1090" y="880"/></Array></mxGeometry></mxCell><mxCell id="c56" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A4A4A;fontSize=11;fontColor=#333333;fontFamily=Helvetica;" edge="1" parent="1" source="c49" target="c47"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1380" y="900"/><mxPoint x="810" y="900"/></Array></mxGeometry></mxCell><mxCell id="c57" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A4A4A;fontSize=11;fontColor=#333333;fontFamily=Helvetica;" edge="1" parent="1" source="c6" target="c13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="605" y="137"/><mxPoint x="605" y="137"/></Array></mxGeometry></mxCell><mxCell id="c58" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A4A4A;fontSize=11;fontColor=#333333;fontFamily=Helvetica;" edge="1" parent="1" source="c15" target="c22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1235" y="247"/><mxPoint x="1235" y="137"/></Array></mxGeometry></mxCell><mxCell id="c59" value="segment" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A4A4A;fontSize=11;fontColor=#333333;fontFamily=Helvetica;" edge="1" parent="1" source="c24" target="c30"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1772" y="365"/><mxPoint x="200" y="365"/></Array></mxGeometry></mxCell><mxCell id="c60" value="top-3 words + p" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A4A4A;fontSize=11;fontColor=#333333;fontFamily=Helvetica;" edge="1" parent="1" source="c35" target="c45"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1710" y="695"/><mxPoint x="200" y="695"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>