<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/slate">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.echogesture.app.HudView
        android:id="@+id/hud"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp">

        <Button android:id="@+id/flip" style="@style/BarButton"
            android:drawableTop="@drawable/ic_flip" android:text="Flip"
            android:contentDescription="Switch between front and back camera" />
        <Button android:id="@+id/speak" style="@style/BarButton"
            android:drawableTop="@drawable/ic_voice_off" android:text="Voice"
            android:contentDescription="Speak words aloud: off" />

        <Button android:id="@+id/now"
            android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1.6"
            android:layout_marginStart="4dp" android:layout_marginEnd="4dp"
            android:background="@drawable/bg_primary" android:minWidth="0dp"
            android:text="Recognise" android:textAllCaps="false" android:textSize="16sp"
            android:textStyle="bold" android:textColor="@color/slate" android:stateListAnimator="@null"
            android:contentDescription="Recognise the sign you just made" />

        <Button android:id="@+id/test" style="@style/BarButton"
            android:drawableTop="@drawable/ic_test" android:text="Test"
            android:contentDescription="Run test videos" />
        <Button android:id="@+id/bench" style="@style/BarButton"
            android:drawableTop="@drawable/ic_bench" android:text="Bench"
            android:contentDescription="Start a 10 minute measurement run" />
    </LinearLayout>
</FrameLayout>
