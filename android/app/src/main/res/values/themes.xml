<resources>
    <style name="Theme.EchoGesture" parent="Theme.AppCompat.NoActionBar">
        <item name="android:fontFamily">@font/atkinson</item>
        <item name="fontFamily">@font/atkinson</item>
        <item name="colorPrimary">@color/slate</item>
        <item name="colorAccent">@color/sure</item>
        <item name="android:windowBackground">@color/slate</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="alertDialogTheme">@style/Dialog.EchoGesture</item>
    </style>

    <style name="Dialog.EchoGesture" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:fontFamily">@font/atkinson</item>
        <item name="fontFamily">@font/atkinson</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:textColorPrimary">@color/paper</item>
        <item name="android:textColorSecondary">@color/paper_dim</item>
        <item name="android:textColor">@color/paper</item>
        <item name="colorAccent">@color/sure</item>
        <item name="buttonBarPositiveButtonStyle">@style/DialogButton</item>
    </style>

    <style name="DialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/sure</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- icon above label, no box: the bar itself is the surface -->
    <style name="BarButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/paper</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:background">@drawable/ripple_round</item>
        <item name="android:drawableTint">@color/paper</item>
    </style>
</resources>
